{
  "version": 2,
  "executable": true,
  "repositoryRoot": ".",
  "surface": {
    "id": "workspace.documents",
    "intent": "browse-and-create-documents",
    "owner": "src/document-route.tsx",
    "renderRoot": "DocumentRoute",
    "semanticOwner": "document-workflow",
    "compositionOwner": "DocumentScreen"
  },
  "scan": {
    "packageJson": "package.json",
    "renderRoots": ["DocumentScreen"],
    "sources": ["src/document-route.tsx", "src/document-screen.tsx"]
  },
  "consumerPropChecks": [
    {
      "module": "example-design-system",
      "components": ["Button"],
      "reviewProps": ["className"],
      "forbiddenProps": ["style"]
    }
  ],
  "implementationConstraints": [],
  "observedRelations": [
    {
      "root": "DocumentRoute",
      "subject": "DocumentRoute",
      "relation": "renders",
      "object": "DocumentScreen"
    }
  ],
  "requiredSlots": [],
  "rules": [
    {
      "id": "create-remains-available",
      "under": "every document collection state",
      "subject": "DocumentScreen",
      "modality": "must",
      "relation": "expose",
      "object": "the create action",
      "because": "creation does not depend on an existing document",
      "owner": "document-workflow",
      "witnesses": [
        {
          "path": "src/document-screen.tsx",
          "anchor": "<Button onClick={onCreate}>"
        }
      ]
    },
    {
      "id": "existing-documents-can-open",
      "under": "a non-empty document collection",
      "subject": "DocumentScreen",
      "modality": "must",
      "relation": "expose",
      "object": "the open action for each document",
      "because": "existing documents are selectable",
      "owner": "document-workflow",
      "witnesses": [
        {
          "path": "src/document-screen.tsx",
          "anchor": "onOpen(document.id)"
        }
      ]
    }
  ],
  "states": {
    "empty": { "kind": "empty" },
    "ready": { "kind": "ready" }
  },
  "actions": {
    "create": "Create document",
    "open": "Open {{item.title}}"
  },
  "actionResolution": "additive",
  "actionMatrix": [
    {
      "when": { "stateKind": "*" },
      "actions": ["create"],
      "decision": "Creation remains available.",
      "dependsOn": ["stateKind"],
      "ruleIds": ["create-remains-available"]
    },
    {
      "forEach": "documents",
      "when": { "item.title": "*" },
      "actions": ["open"],
      "decision": "{{item.title}} can open.",
      "dependsOn": ["item.title"],
      "ruleIds": ["existing-documents-can-open"]
    }
  ],
  "stackTemplate": [
    "DocumentRoute",
    "  DocumentScreen",
    "    {{#documents}}Document: {{item.title}}{{/documents}}",
    "    Actions: {{actionLabels}}"
  ]
}
